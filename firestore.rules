rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Remplace par TON email admin (le même que dans src/firebaseConfig.js)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "pilotepower2@gmail.com";
    }

    match /shops/{shopId} {
      allow read: if resource.data.statut == "valide"
                  || (request.auth != null && resource.data.ownerId == request.auth.uid)
                  || isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.statut == "en_attente"
                    && request.resource.data.premium == false;
      allow update: if isAdmin()
                    || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["noteSum", "noteCount"]))
                    || (request.auth != null
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.statut == resource.data.statut
                        && request.resource.data.premium == resource.data.premium
                        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin();

      match /products/{pid} {
        allow read: if true;
        allow write: if request.auth != null
          && (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid || isAdmin());
      }
      match /reviews/{rid} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                      && request.resource.data.etoiles >= 1 && request.resource.data.etoiles <= 5;
        allow delete: if isAdmin();
      }
    }

    match /orders/{oid} {
      allow create: if request.auth != null && request.resource.data.clientId == request.auth.uid;
      allow read: if (request.auth != null && (resource.data.clientId == request.auth.uid || resource.data.shopOwnerId == request.auth.uid)) || isAdmin();
      allow update: if request.auth != null && resource.data.shopOwnerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut"]);
    }

    match /chats/{cid} {
      allow read: if request.auth != null && (resource.data.clientId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create, update: if request.auth != null && (request.resource.data.clientId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
      match /msgs/{mid} {
        allow read, create: if request.auth != null && (
          get(/databases/$(database)/documents/chats/$(cid)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(cid)).data.ownerId == request.auth.uid);
      }
    }

    match /stories/{sid} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow delete: if (request.auth != null && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /referrals/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.parrainId != uid;
      allow read: if request.auth != null && (request.auth.uid == uid || resource.data.parrainId == request.auth.uid);
    }

    match /settings/{sid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /emergencies/{v} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid}/favorites/{fid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
